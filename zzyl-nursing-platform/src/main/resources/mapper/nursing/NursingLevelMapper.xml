<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zzyl.nursing.mapper.NursingLevelMapper">

    <resultMap id="NursingLevelVoResult"
               type="com.zzyl.nursing.vo.NursingLevelVo">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="planId" column="plan_id"/>
        <result property="planName" column="plan_name"/>
        <result property="fee" column="fee"/>
        <result property="status" column="status"/>
        <result property="description" column="description"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectNursingLevelVoList"
            resultMap="NursingLevelVoResult">
        select
        l.id,
        l.name,
        l.plan_id,
        p.plan_name,
        l.fee,
        l.status,
        l.description,
        l.create_time
        from nursing_level l
        left join nursing_plan p on l.plan_id = p.id
        <where>
            <if test="name != null and name != ''">
                and l.name like concat('%', #{name}, '%')
            </if>
            <if test="planId != null">
                and l.plan_id = #{planId}
            </if>
            <if test="status != null">
                and l.status = #{status}
            </if>
        </where>
        order by l.id desc
    </select>

</mapper>